{
  "$id": "event.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "origin", "startsAt", "endsAt"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "$ref": "common.json#/definitions/id" },
    "origin": { "enum": ["guild", "external"] },
    "sessionId": { "$ref": "common.json#/definitions/id" },
    "title": { "$ref": "common.json#/definitions/text" },
    "summary": { "$ref": "common.json#/definitions/text" },
    "type": { "$ref": "common.json#/definitions/type" },
    "tags": { "$ref": "common.json#/definitions/texts" },
    "startsAt": { "$ref": "common.json#/definitions/text" },
    "endsAt": { "$ref": "common.json#/definitions/text" },
    "example": { "type": "boolean" },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registration": { "$ref": "common.json#/definitions/text" },
        "recording": { "$ref": "common.json#/definitions/text" },
        "notes": { "$ref": "common.json#/definitions/text" },
        "slides": { "$ref": "common.json#/definitions/text" },
        "demo": { "$ref": "common.json#/definitions/text" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "origin": { "const": "guild" } } },
      "then": {
        "required": ["sessionId"],
        "not": { "anyOf": [{ "required": ["title"] }, { "required": ["summary"] }, { "required": ["type"] }, { "required": ["tags"] }] }
      },
      "else": {
        "required": ["title", "summary", "type", "tags", "links"],
        "properties": { "links": { "required": ["registration"] } },
        "not": { "required": ["sessionId"] }
      }
    }
  ]
}
